---
import { getCollection } from "astro:content";
import "../../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<html lang="en" data-theme="device">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog</title>
  </head>
  <body class="bg-background text-foreground min-h-screen font-(family-name:--font-noto-sans)">
    <main class="mx-auto max-w-2xl px-6 py-16">
      <h1 class="text-4xl font-medium mb-10">Blog</h1>
      <ul class="flex flex-col gap-8">
        {posts.map((post) => (
          <li>
              <a
              href={`${prefix}blog/${post.id}/`}
              class="text-xl font-medium hover:underline decoration-dashed underline-offset-4"
            >
              {post.data.title}
            </a>
            <p class="text-muted-foreground mt-1">{post.data.description}</p>
            <p class="text-sm text-muted-foreground mt-1">
              {dateFormatter.format(post.data.date)}
            </p>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
