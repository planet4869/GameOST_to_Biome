---
import { getCollection } from "astro:content";
import "../../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<html lang="en" data-theme="device">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gyoyoung Koo's Blog</title>
  </head>
  <body class="bg-background text-foreground min-h-screen font-(family-name:--font-noto-sans)">
    <main class="mx-auto max-w-2xl px-6 py-16">
      <h1 class="text-4xl font-medium mb-2">Gyoyoung Koo's Blog</h1>
      {/* [※ 원하시면 한 줄 소개 문구 추가] */}
      <ul class="flex flex-col gap-5 mt-10">
        {posts.map((post) => (
          <li>
            <a href={`${prefix}blog/${post.id}/`} class="group block rounded-xl border border-border p-6 transition-colors hover:border-outline hover:bg-accent/40">
              <p class="text-sm text-muted-foreground mb-2">{dateFormatter.format(post.data.date)}</p>
              <h2 class="text-2xl font-medium group-hover:underline decoration-dashed underline-offset-4">{post.data.title}</h2>
              <p class="text-muted-foreground mt-2">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
